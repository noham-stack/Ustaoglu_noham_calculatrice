<Window x:Class="NohamCalculette.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mokuton Calculator"
        Height="650"
        Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#160D07">

    <!-- ============================= -->
    <!-- RESSOURCES / STYLES -->
    <!-- ============================= -->

    <Window.Resources>

        <!-- ============================= -->
        <!-- BOUTONS CHIFFRES -->
        <!-- ============================= -->

        <Style x:Key="WoodButton" TargetType="Button">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#241207"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="WoodBorder"
                                CornerRadius="12"
                                BorderThickness="3"
                                BorderBrush="#5B3219">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop Color="#D6A15B" Offset="0"/>
                                    <GradientStop Color="#B87A3D" Offset="0.5"/>
                                    <GradientStop Color="#79431E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  BlurRadius="7"
                                                  ShadowDepth="4"
                                                  Opacity="0.7"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Souris -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WoodBorder"
                                        Property="BorderBrush"
                                        Value="#F1C77B"/>
                            </Trigger>

                            <!-- Clic -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WoodBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================= -->
        <!-- BOUTONS OPERATIONS -->
        <!-- ============================= -->

        <Style x:Key="OperationButton"
               TargetType="Button"
               BasedOn="{StaticResource WoodButton}">

            <Setter Property="Foreground" Value="#FFE1AA"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="OperationBorder"
                                CornerRadius="12"
                                BorderThickness="3"
                                BorderBrush="#411A0E">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop Color="#8E4B2D" Offset="0"/>
                                    <GradientStop Color="#65321F" Offset="0.5"/>
                                    <GradientStop Color="#35180E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  BlurRadius="7"
                                                  ShadowDepth="4"
                                                  Opacity="0.8"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Souris -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OperationBorder"
                                        Property="BorderBrush"
                                        Value="#D99656"/>
                            </Trigger>

                            <!-- Clic -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OperationBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================= -->
        <!-- BOUTON EGAL -->
        <!-- ============================= -->

        <Style x:Key="EqualButton"
               TargetType="Button"
               BasedOn="{StaticResource WoodButton}">

            <Setter Property="Foreground" Value="#F6E2B7"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="EqualBorder"
                                CornerRadius="12"
                                BorderThickness="3"
                                BorderBrush="#263219">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop Color="#66744A" Offset="0"/>
                                    <GradientStop Color="#465332" Offset="0.5"/>
                                    <GradientStop Color="#28321D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  BlurRadius="7"
                                                  ShadowDepth="4"
                                                  Opacity="0.8"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Souris -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EqualBorder"
                                        Property="BorderBrush"
                                        Value="#A8BD73"/>
                            </Trigger>

                            <!-- Clic -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EqualBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <!-- ===================================== -->
    <!-- GROS CADRE EN BOIS -->
    <!-- ===================================== -->

    <Border Margin="20"
            CornerRadius="30"
            BorderThickness="12"
            BorderBrush="#30170A">

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#8A5028" Offset="0"/>
                <GradientStop Color="#4C2813" Offset="0.3"/>
                <GradientStop Color="#2F160A" Offset="0.6"/>
                <GradientStop Color="#6A381A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>


        <!-- ===================================== -->
        <!-- CADRE INTERIEUR -->
        <!-- ===================================== -->

        <Border Margin="7"
                Padding="17"
                CornerRadius="20"
                BorderThickness="4"
                BorderBrush="#9A6032"
                Background="#28150C">

            <Grid>

                <!-- LIGNES -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- COLONNES -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================= -->
                <!-- ECRAN -->
                <!-- ================================= -->

                <Border Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Margin="7,7,7,15"
                        CornerRadius="15"
                        BorderThickness="5"
                        BorderBrush="#73451F">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">
                            <GradientStop Color="#302820" Offset="0"/>
                            <GradientStop Color="#12100D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <TextBox Name="TB_Display"
                             Text="0"
                             FontSize="52"
                             FontWeight="Bold"
                             Foreground="#F4D8A4"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"
                             Padding="15"/>

                </Border>


                <!-- ================================= -->
                <!-- LIGNE 1 -->
                <!-- ================================= -->

                <Button Grid.Row="1"
                        Grid.Column="0"
                        Name="BTN_1"
                        Content="1"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="1"
                        Grid.Column="1"
                        Name="BTN_2"
                        Content="2"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Name="BTN_3"
                        Content="3"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="1"
                        Grid.Column="3"
                        Name="BTN_Plus"
                        Content="+"
                        Style="{StaticResource OperationButton}"/>


                <!-- ================================= -->
                <!-- LIGNE 2 -->
                <!-- ================================= -->

                <Button Grid.Row="2"
                        Grid.Column="0"
                        Name="BTN_4"
                        Content="4"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="2"
                        Grid.Column="1"
                        Name="BTN_5"
                        Content="5"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="2"
                        Grid.Column="2"
                        Name="BTN_6"
                        Content="6"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="2"
                        Grid.Column="3"
                        Name="BTN_Moins"
                        Content="-"
                        Style="{StaticResource OperationButton}"/>


                <!-- ================================= -->
                <!-- LIGNE 3 -->
                <!-- ================================= -->

                <Button Grid.Row="3"
                        Grid.Column="0"
                        Name="BTN_7"
                        Content="7"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="3"
                        Grid.Column="1"
                        Name="BTN_8"
                        Content="8"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="3"
                        Grid.Column="2"
                        Name="BTN_9"
                        Content="9"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="3"
                        Grid.Column="3"
                        Name="BTN_Fois"
                        Content="*"
                        Style="{StaticResource OperationButton}"/>


                <!-- ================================= -->
                <!-- LIGNE 4 -->
                <!-- ================================= -->

                <Button Grid.Row="4"
                        Grid.Column="0"
                        Name="BTN_0"
                        Content="0"
                        Style="{StaticResource WoodButton}"/>

                <Button Grid.Row="4"
                        Grid.Column="1"
                        Name="BTN_2CLR"
                        Content="CLR"
                        FontSize="19"
                        Style="{StaticResource OperationButton}"/>

                <Button Grid.Row="4"
                        Grid.Column="2"
                        Name="BTN_egale"
                        Content="="
                        Style="{StaticResource EqualButton}"/>

                <Button Grid.Row="4"
                        Grid.Column="3"
                        Name="BTN_Divise"
                        Content="/"
                        Style="{StaticResource OperationButton}"/>

            </Grid>

        </Border>

    </Border>

</Window>