<Window x:Class="NohamCalculette.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ma calculatrice"
        Height="550"
        Width="470"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F5">

	<Window.Resources>
		<Style x:Key="PastelButton" TargetType="Button">
			<Setter Property="Background" Value="#E6DDF5"/>
			<Setter Property="Foreground" Value="#51445F"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="23"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="4"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="5">
							<ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="10">

		<Grid.RowDefinitions>
			<RowDefinition Height="100"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Écran -->
		<TextBox Name="TB_Display"
                 Grid.Row="0"
                 Grid.ColumnSpan="5"
                 Text="0"
                 FontSize="35"
                 FontWeight="Bold"
                 Foreground="#65536E"
                 Background="#FFFAFC"
                 BorderBrush="#E6CFEA"
                 BorderThickness="2"
                 IsReadOnly="True"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 Padding="10"
                 Margin="5"/>

		<!-- Ligne 1 -->
		<Button Name="BTN_7" Content="7"
                Grid.Row="1" Grid.Column="0"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_8" Content="8"
                Grid.Row="1" Grid.Column="1"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_9" Content="9"
                Grid.Row="1" Grid.Column="2"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_Divise" Content="÷"
                Grid.Row="1" Grid.Column="3"
                Background="#F6CADD"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_2CLR" Content="CLR"
                Grid.Row="1" Grid.Column="4"
                FontSize="16"
                Background="#F5D6C6"
                Style="{StaticResource PastelButton}"/>

		<!-- Ligne 2 -->
		<Button Name="BTN_4" Content="4"
                Grid.Row="2" Grid.Column="0"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_5" Content="5"
                Grid.Row="2" Grid.Column="1"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_6" Content="6"
                Grid.Row="2" Grid.Column="2"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_Fois" Content="×"
                Grid.Row="2" Grid.Column="3"
                Background="#F6CADD"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_Moins" Content="-"
                Grid.Row="2" Grid.Column="4"
                Background="#F6CADD"
                Style="{StaticResource PastelButton}"/>

		<!-- Ligne 3 -->
		<Button Name="BTN_1" Content="1"
                Grid.Row="3" Grid.Column="0"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_2" Content="2"
                Grid.Row="3" Grid.Column="1"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_3" Content="3"
                Grid.Row="3" Grid.Column="2"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_Plus" Content="+"
                Grid.Row="3" Grid.Column="3"
                Background="#F6CADD"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_Virgule" Content=","
                Grid.Row="3" Grid.Column="4"
                Style="{StaticResource PastelButton}"/>

		<!-- Ligne 4 -->
		<Button Name="BTN_0" Content="0"
                Grid.Row="4" Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource PastelButton}"/>
		<Button Name="BTN_egale" Content="="
                Grid.Row="4" Grid.Column="2"
                Grid.ColumnSpan="3"
                Background="#CDE8D5"
                Foreground="#416B50"
                Style="{StaticResource PastelButton}"/>

		<!-- Ligne 5 -->
		<TextBlock Text="Calculatrice"
                   Grid.Row="5"
                   Grid.ColumnSpan="5"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#9A83A8"
                   FontSize="14"/>

	</Grid>
</Window>